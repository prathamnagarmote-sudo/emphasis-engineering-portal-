# -----------------------------------------------------------------------------
# Emphasis Engineering — Local Environment Configuration Template
# -----------------------------------------------------------------------------
# Instructions:
# 1. Copy this file and rename it to ".env.local"
# 2. Supply your private credentials for each placeholder key below.
# 3. DO NOT commit ".env.local" to your Git repository (it is ignored by default).
# -----------------------------------------------------------------------------

# NextAuth Configuration
# For local dev: http://localhost:3000
# For production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_super_secret_session_encryption_string_here

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/database_name

# Google OAuth Integration (For Student Google Sign-In)
# Leave blank if Google Auth is disabled
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Resend API Credentials (For Transactional & Contact Emails)
RESEND_API_KEY=re_your_resend_api_key_here

# Developer CMS Panel Login Credentials
DEV_PANEL_USERNAME=developer
DEV_PANEL_PASSWORD=your_secure_developer_password_here

# Cloudinary Integration (For Image & Seeding Uploads in Dev Panel)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset_here

# Stripe Integration (For Portal Payments & Checkout)
# Publishable Key (Safe to be public / prefix: pk_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key_here
# Secret Key (Keep strictly server-side / prefix: sk_...)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
# Webhook Signing Secret (For /api/webhook/stripe)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here

# Service Notifications & Fallsbacks
INSTRUCTOR_EMAIL=engineeringemphasis@gmail.com
EMAIL_USER=your_sending_smtp_email_user@gmail.com
EMAIL_PASS=your_sending_smtp_email_password_here
